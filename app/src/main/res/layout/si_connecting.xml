<?xml version="1.0" encoding="utf-8"?>
<!-- Connecting (DESIGN.md): full window ground; centered spinner 48, "Connecting to <PC>…" (title),
     status line (label muted), secondary Cancel. Never shows the big PC's monitors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/si_ground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/si_size_gutter">

    <com.limelight.ui.si.SiSpinner
        android:layout_width="48dp"
        android:layout_height="48dp" />

    <TextView
        android:id="@+id/siConnectingTitle"
        style="@style/SiText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/si_space_lg"
        android:gravity="center" />

    <TextView
        android:id="@+id/siConnectingStatus"
        style="@style/SiText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/si_space_xs"
        android:gravity="center"
        android:textColor="@color/si_muted" />

    <TextView
        android:id="@+id/siConnectingCancel"
        style="@style/SiButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/si_space_lg"
        android:text="@string/si_cancel" />
</LinearLayout>

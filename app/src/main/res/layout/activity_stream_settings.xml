<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (DESIGN.md): header with back + "Settings". Wide windows (>= 760): sidebar of
     categories (220) on the left, the category's groups in a column (max 560) on the right.
     Narrow windows: the category list is the page; picking one pushes its page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/si_ground"
    android:orientation="vertical"
    tools:context=".preferences.StreamSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/si_size_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/si_size_gutter"
        android:paddingEnd="@dimen/si_size_gutter">

        <ImageButton
            android:id="@+id/settingsBack"
            style="@style/SiIconButton"
            android:contentDescription="@string/si_back"
            android:src="@drawable/ic_si_back" />

        <TextView
            android:id="@+id/settingsTitle"
            style="@style/SiText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/si_space_md"
            android:text="@string/si_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/settingsSidebarScroll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settingsSidebar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/si_size_gutter"
                android:paddingTop="@dimen/si_space_xs"
                android:paddingBottom="@dimen/si_space_lg" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/settingsContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="@dimen/si_space_lg"
            android:paddingEnd="@dimen/si_size_gutter">

            <com.limelight.ui.si.SiMaxWidthLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxWidth="560dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/stream_settings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.limelight.ui.si.SiMaxWidthLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

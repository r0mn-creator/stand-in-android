<?xml version="1.0" encoding="utf-8"?>
<!-- App card: box art 3:4 with radius md, the name under it in bodyStrong.
     The focused card scales 1.04 and gets the focus ring on its artwork (AppView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/si_space_xs"
    android:paddingTop="@dimen/si_space_sm"
    android:paddingEnd="@dimen/si_space_xs"
    android:paddingBottom="@dimen/si_space_sm">

    <FrameLayout
        android:id="@+id/si_app_art"
        android:layout_width="144dp"
        android:layout_height="192dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/si_surface"
            app:cardCornerRadius="@dimen/si_radius_md"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <RelativeLayout
                android:id="@+id/grid_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerInParent="true" />

                <!-- Shown by the art loader only when there is no artwork -->
                <TextView
                    android:id="@+id/grid_text"
                    style="@style/SiText.BodyStrong"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="@dimen/si_space_sm"
                    android:textColor="@color/si_muted" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <TextView
        android:id="@+id/si_app_name"
        style="@style/SiText.BodyStrong"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/si_space_xs"
        android:ellipsize="end"
        android:singleLine="true" />

    <TextView
        android:id="@+id/si_app_state"
        style="@style/SiText.Caption"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:textColor="@color/si_muted" />
</LinearLayout>

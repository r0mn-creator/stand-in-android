<?xml version="1.0" encoding="utf-8"?>
<!-- Home (DESIGN.md "Home"): header, "Your PCs", hero card for the PC you most likely want,
     then one row of tiles with the add tile always last and always visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/si_ground"
    android:orientation="vertical"
    tools:context=".PcView">

    <include layout="@layout/si_header_home" />

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/si_size_gutter"
            android:paddingEnd="@dimen/si_size_gutter"
            android:paddingBottom="@dimen/si_space_lg">

            <com.limelight.ui.si.SiMaxWidthLayout
                android:id="@+id/siColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:maxWidth="@dimen/si_size_content_width">

                <TextView
                    style="@style/SiSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/si_space_xs"
                    android:text="@string/si_your_pcs" />

                <!-- Hero card -->
                <FrameLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/si_card">

                    <LinearLayout
                        android:id="@+id/heroContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/si_space_lg">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp">

                            <ImageView
                                android:id="@+id/heroIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_si_tower" />

                            <com.limelight.ui.si.SiSpinner
                                android:id="@+id/heroSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/heroName"
                            style="@style/SiText.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/si_space_xs"
                            android:layout_marginStart="56dp"
                            android:layout_marginEnd="56dp"
                            android:ellipsize="end"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/heroStatus"
                            style="@style/SiText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="@color/si_muted" />

                        <!-- Keeps the card the same height when a state has no button -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/si_size_button_large"
                            android:layout_marginTop="@dimen/si_space_md">

                            <TextView
                                android:id="@+id/heroButton"
                                style="@style/SiButton.Primary"
                                android:focusedByDefault="true"
                                android:layout_width="@dimen/si_size_hero_button_width"
                                android:layout_height="@dimen/si_size_button_large" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Empty state: no PCs yet -->
                    <LinearLayout
                        android:id="@+id/heroEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/si_space_lg"
                        android:visibility="gone">

                        <com.limelight.ui.si.SiSpinner
                            android:layout_width="48dp"
                            android:layout_height="48dp" />

                        <TextView
                            style="@style/SiText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/si_space_md"
                            android:text="@string/si_looking" />

                        <TextView
                            style="@style/SiText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/si_space_xs"
                            android:gravity="center"
                            android:text="@string/si_looking_detail"
                            android:textColor="@color/si_muted" />

                        <TextView
                            android:id="@+id/heroAddManually"
                            style="@style/SiButton.Text"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="@dimen/si_space_md"
                            android:text="@string/si_add_manually" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/heroMore"
                        style="@style/SiIconButton"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/si_space_sm"
                        android:contentDescription="@string/si_more"
                        android:src="@drawable/ic_si_more" />
                </FrameLayout>

                <!-- Tiles: one row with 12 gaps, scrolling sideways; the add tile stays put -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/si_space_sm"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:id="@+id/pcRowScroll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/pcRow"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/si_size_tile_height"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/manuallyAddPc"
                        android:layout_width="@dimen/si_size_tile_width"
                        android:layout_height="@dimen/si_size_tile_height"
                        android:layout_marginStart="@dimen/si_space_sm"
                        android:background="@drawable/si_tile_add"
                        android:clickable="true"
                        android:contentDescription="@string/si_add_pc"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/si_size_icon"
                            android:layout_height="@dimen/si_size_icon"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_si_plus" />

                        <TextView
                            style="@style/SiText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/si_add_pc"
                            android:textColor="@color/si_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.limelight.ui.si.SiMaxWidthLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>

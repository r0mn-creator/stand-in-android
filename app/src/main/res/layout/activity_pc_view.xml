<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-In home: one big card for the PC you most likely want, the rest in a row below -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#12161C"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    tools:context=".PcView">

    <LinearLayout
        android:id="@+id/siHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/si_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Stand-In"
            android:textColor="#E6EAF0"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionTag"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:gravity="center"
            android:background="@drawable/version_tag_background"
            android:text="@string/release_tag"
            android:textColor="#98A2B3"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/si_icon_button"
            android:contentDescription="Settings"
            android:focusable="true"
            android:src="@drawable/ic_si_gear" />
    </LinearLayout>

    <TextView
        android:id="@+id/siYourPcs"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/siHeader"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="@string/si_your_pcs"
        android:textColor="#98A2B3"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/siYourPcs"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/si_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/heroIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_si_tower" />

            <ProgressBar
                android:id="@+id/heroSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#2DD4BF"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E6EAF0"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#98A2B3"
            android:textSize="14sp" />

        <!-- A TextView, not a Button: the Material theme would tint a Button purple -->
        <TextView
            android:id="@+id/heroButton"
            android:layout_width="220dp"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/si_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="#04201C"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pcRow"
        android:layout_width="720dp"
        android:layout_height="104dp"
        android:layout_below="@id/heroCard"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- The PC cards scroll sideways once there are more than fit -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <FrameLayout
                android:id="@+id/pcFragmentContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/manuallyAddPc"
            android:layout_width="112dp"
            android:layout_height="96dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/si_add_card_states"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#E6EAF0"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/si_add_pc"
                android:textColor="#98A2B3"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kept for the code that toggles it; the big card shows the searching state instead -->
    <RelativeLayout
        android:id="@+id/no_pc_found_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/helpButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</RelativeLayout>

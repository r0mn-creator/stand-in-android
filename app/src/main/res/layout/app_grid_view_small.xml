<?xml version="1.0" encoding="utf-8"?>
<!-- All apps grid, small box art. No list selector: AppView scales the focused card and rings its artwork. -->
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:numColumns="auto_fit"
    android:columnWidth="128dp"
    android:stretchMode="spacingWidthUniform"
    android:paddingStart="@dimen/si_size_gutter"
    android:paddingEnd="@dimen/si_size_gutter"
    android:paddingBottom="@dimen/si_space_lg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:listSelector="@android:color/transparent"
    android:drawSelectorOnTop="false"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:gravity="center"/>

<?xml version="1.0" encoding="utf-8"?>
<!-- Slider row: title + current value (body, right), subtitle, slider below:
     4px raised track, accent fill, 20 thumb in text color. Left/right on the slider changes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:addStatesFromChildren="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/si_space_md"
    android:paddingTop="@dimen/si_space_sm"
    android:paddingEnd="@dimen/si_space_md"
    android:paddingBottom="@dimen/si_space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@android:id/title"
            style="@style/SiText.BodyStrong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/si_text_enabled" />

        <TextView
            android:id="@+id/si_value"
            style="@style/SiText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/si_space_md"
            android:textColor="@color/si_text_enabled" />
    </LinearLayout>

    <TextView
        android:id="@android:id/summary"
        style="@style/SiText.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/si_muted_enabled" />

    <SeekBar
        android:id="@+id/si_seekbar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="-8dp"
        android:layout_marginEnd="-8dp"
        android:background="@null"
        android:defaultFocusHighlightEnabled="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:progressDrawable="@drawable/si_slider_track"
        android:splitTrack="false"
        android:thumb="@drawable/si_slider_thumb"
        android:thumbOffset="10dp" />
</LinearLayout>

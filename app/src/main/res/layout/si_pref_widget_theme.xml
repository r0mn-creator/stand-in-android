<?xml version="1.0" encoding="utf-8"?>
<!-- Theme swatch (the theme's ground, surface and accent), then its name -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/si_swatch" />

    <TextView
        style="@style/SiText.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/si_space_sm"
        android:text="@string/si_theme_midnight"
        android:textColor="@color/si_muted" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- PC tile: 112x96, radius md, padding 12. Tower icon on top; name and status row at the bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/si_size_tile_width"
    android:layout_height="@dimen/si_size_tile_height"
    android:background="@drawable/si_tile"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/si_space_sm">

    <ImageView
        android:id="@+id/grid_image"
        android:layout_width="@dimen/si_size_icon"
        android:layout_height="@dimen/si_size_icon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_si_tower" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/grid_text"
        style="@style/SiText.BodyStrong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="12dp"
            android:layout_height="12dp">

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="@dimen/si_size_status_dot"
                android:layout_height="@dimen/si_size_status_dot"
                android:layout_gravity="center"
                android:src="@drawable/si_dot" />

            <com.limelight.ui.si.SiSpinner
                android:id="@+id/si_status_spinner"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_status"
            style="@style/SiText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:textColor="@color/si_muted" />
    </LinearLayout>
</LinearLayout>

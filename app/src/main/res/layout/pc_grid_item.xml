<?xml version="1.0" encoding="utf-8"?>
<!-- A small PC card in the row under the big card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="112dp"
    android:layout_height="96dp"
    android:background="@drawable/si_small_card"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/grid_image_layout"
        android:layout_width="22dp"
        android:layout_height="22dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/grid_spinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateTint="#98A2B3" />
    </FrameLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#E6EAF0"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="8dp"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/grid_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="#98A2B3"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

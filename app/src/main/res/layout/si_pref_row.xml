<?xml version="1.0" encoding="utf-8"?>
<!-- Row (DESIGN.md): min height 56 (68 with subtitle), padding 16. Optional leading icon in a 36
     circle; title bodyStrong; subtitle label muted, up to 2 lines; trailing widget. The adapter
     gives each row its piece of the group card (first, middle, last, single). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:defaultFocusHighlightEnabled="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/si_size_row"
    android:orientation="horizontal"
    android:paddingStart="@dimen/si_space_md"
    android:paddingTop="@dimen/si_space_sm"
    android:paddingEnd="@dimen/si_space_md"
    android:paddingBottom="@dimen/si_space_sm">

    <FrameLayout
        android:id="@android:id/icon_frame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/si_space_sm"
        android:background="@drawable/si_icon_circle">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/si_size_icon_small"
            android:layout_height="@dimen/si_size_icon_small"
            android:layout_gravity="center"
            android:tint="@color/si_muted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            style="@style/SiText.BodyStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/si_text_enabled" />

        <TextView
            android:id="@android:id/summary"
            style="@style/SiText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/si_muted_enabled" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/si_space_md"
        android:gravity="center_vertical|end"
        android:orientation="horizontal" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Add a PC (DESIGN.md): a dialog over the home screen. Title, body, input, errors under the
     input in danger caption, then Cancel and Add. While adding, Add shows a spinner and the input locks. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/siScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/si_size_gutter"
    tools:context=".preferences.AddComputerManually">

    <com.limelight.ui.si.SiMaxWidthLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/si_dialog_background"
        android:clickable="true"
        android:elevation="16dp"
        android:maxWidth="@dimen/si_size_dialog_width"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            style="@style/SiText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_add_title" />

        <TextView
            style="@style/SiText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/si_space_xs"
            android:text="@string/si_add_body"
            android:textColor="@color/si_muted" />

        <TextView
            style="@style/SiText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/si_space_lg"
            android:layout_marginBottom="@dimen/si_space_xs"
            android:labelFor="@id/hostTextView"
            android:text="@string/si_add_label"
            android:textColor="@color/si_muted" />

        <EditText
            android:id="@+id/hostTextView"
            style="@style/SiText.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/si_size_input"
            android:background="@drawable/si_input"
            android:hint="@string/si_add_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textUri"
            android:paddingStart="@dimen/si_space_md"
            android:paddingEnd="@dimen/si_space_md"
            android:singleLine="true"
            android:textColorHint="@color/si_subtle"
            android:textCursorDrawable="@drawable/si_cursor">

            <requestFocus />
        </EditText>

        <TextView
            android:id="@+id/addPcError"
            style="@style/SiText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/si_space_xs"
            android:textColor="@color/si_danger"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/si_space_lg"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addPcCancel"
                style="@style/SiButton.Secondary"
                android:layout_width="wrap_content"
                android:text="@string/si_cancel" />

            <FrameLayout
                android:id="@+id/addPcButton"
                style="@style/SiButton.Primary"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/si_space_sm"
                android:contentDescription="@string/si_add">

                <TextView
                    android:id="@+id/addPcButtonText"
                    style="@style/SiText.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:text="@string/si_add"
                    android:textColor="@color/si_on_accent_button" />

                <com.limelight.ui.si.SiSpinner
                    android:id="@+id/addPcSpinner"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </com.limelight.ui.si.SiMaxWidthLayout>
</FrameLayout>

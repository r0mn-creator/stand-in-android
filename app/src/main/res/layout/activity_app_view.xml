<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/si_ground"
    tools:context=".AppView">

    <!-- Header: back + the PC's name -->
    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/si_size_header_height"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/si_size_gutter"
        android:paddingEnd="@dimen/si_size_gutter">

        <ImageButton
            android:id="@+id/siBackButton"
            style="@style/SiIconButton"
            android:contentDescription="@string/si_back"
            android:src="@drawable/ic_si_back" />

        <TextView
            android:id="@+id/appListText"
            style="@style/SiText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/si_space_md"
            android:layout_weight="1"
            android:ellipsize="end"
            android:preferKeepClear="true"
            android:singleLine="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appHeader"
        android:layout_alignParentBottom="true"
        android:clipChildren="false" />

    <!-- Profiles aren't part of Stand-In's design; kept for the existing code -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/profile_manager_choose_profile"
        android:visibility="gone"
        app:icon="@drawable/ic_profiles" />

</RelativeLayout>

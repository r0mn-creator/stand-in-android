<?xml version="1.0" encoding="utf-8"?>
<!-- Inline progress inside a dialog: spinner 20 + body muted -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.limelight.ui.si.SiSpinner
        android:layout_width="20dp"
        android:layout_height="20dp" />

    <TextView
        android:id="@+id/siProgressText"
        style="@style/SiText.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/si_space_sm"
        android:layout_weight="1"
        android:textColor="@color/si_muted" />
</LinearLayout>

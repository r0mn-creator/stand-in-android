<?xml version="1.0" encoding="utf-8"?>
<!-- Input: raised, 1px borderStrong, radius sm; focus 2px accent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="@dimen/si_size_focus_ring" android:color="@color/si_accent" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border_strong" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
</selector>

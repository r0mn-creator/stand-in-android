<?xml version="1.0" encoding="utf-8"?>
<!-- Activated = the PC shown in the big card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#222A35" />
            <stroke android:width="2dp" android:color="#2DD4BF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2029" />
            <stroke android:width="1dp" android:color="#2C3542" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

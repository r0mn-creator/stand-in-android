<?xml version="1.0" encoding="utf-8"?>
<!-- Icon button: 44, radius sm, surface + border; focus ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="@dimen/si_size_focus_ring" android:color="@color/si_accent_hover" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
    <item android:state_hovered="true"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/si_surface" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:radius="@dimen/si_radius_sm" /></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: 44x26 capsule. Off raised + borderStrong, on accent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"><shape android:shape="rectangle"><solid android:color="@color/si_accent" /><corners android:radius="13dp" /><size android:width="44dp" android:height="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border_strong" /><corners android:radius="13dp" /><size android:width="44dp" android:height="26dp" /></shape></item>
</selector>

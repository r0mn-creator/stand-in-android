<?xml version="1.0" encoding="utf-8"?>
<!-- Theme swatch: ground with a borderStrong outline, a surface panel and the accent dot -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/si_ground" />
            <stroke android:width="1dp" android:color="@color/si_border_strong" />
            <corners android:radius="@dimen/si_radius_xs" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:bottom="5dp" android:right="17dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/si_surface" />
            <stroke android:width="1dp" android:color="@color/si_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="25dp" android:top="9dp" android:bottom="9dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/si_accent" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Group row, bottom piece: the group card is drawn by its rows; no separators before API 23 (layer gravity/height); the focus ring follows the group shape -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><layer-list><item android:top="0dp" android:bottom="0dp"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="@dimen/si_size_focus_ring" android:color="@color/si_accent_hover" /><corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="@dimen/si_radius_lg" android:bottomRightRadius="@dimen/si_radius_lg" /></shape></item></layer-list></item>
    <item android:state_pressed="true"><layer-list><item android:top="-2dp" android:bottom="0dp"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="@dimen/si_radius_lg" android:bottomRightRadius="@dimen/si_radius_lg" /></shape></item></layer-list></item>
    <item android:state_hovered="true"><layer-list><item android:top="-2dp" android:bottom="0dp"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="@dimen/si_radius_lg" android:bottomRightRadius="@dimen/si_radius_lg" /></shape></item></layer-list></item>
    <item><layer-list><item android:top="-2dp" android:bottom="0dp"><shape android:shape="rectangle"><solid android:color="@color/si_surface" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="@dimen/si_radius_lg" android:bottomRightRadius="@dimen/si_radius_lg" /></shape></item></layer-list></item>
</selector>

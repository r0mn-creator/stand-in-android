<?xml version="1.0" encoding="utf-8"?>
<!-- Add tile: transparent, 1px dashed borderStrong (6 dash, 4 gap) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="@dimen/si_size_focus_ring" android:color="@color/si_accent_hover" /><corners android:radius="@dimen/si_radius_md" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/si_surface" /><stroke android:width="1dp" android:color="@color/si_border_strong" android:dashWidth="6dp" android:dashGap="4dp" /><corners android:radius="@dimen/si_radius_md" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="@color/si_border_strong" android:dashWidth="6dp" android:dashGap="4dp" /><corners android:radius="@dimen/si_radius_md" /></shape></item>
</selector>

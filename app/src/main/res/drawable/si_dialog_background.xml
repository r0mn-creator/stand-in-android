<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog panel: the inset keeps the rounded corners off the screen edge -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp" android:insetRight="24dp"
    android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/si_surface" />
        <stroke android:width="1dp" android:color="@color/si_border" />
        <corners android:radius="28dp" />
    </shape>
</inset>

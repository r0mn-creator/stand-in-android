<?xml version="1.0" encoding="utf-8"?>
<!-- Slider thumb: 20, text color; focused gets the 2px accentHover ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/si_text" />
            <stroke android:width="@dimen/si_size_focus_ring" android:color="@color/si_accent_hover" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/si_subtle" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/si_text" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</selector>

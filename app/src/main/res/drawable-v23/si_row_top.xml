<?xml version="1.0" encoding="utf-8"?>
<!-- Group row, top piece: the group card is drawn by its rows; separators inset 16; the focus ring follows the group shape -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><layer-list><item android:top="0dp" android:bottom="0dp"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="@dimen/si_size_focus_ring" android:color="@color/si_accent_hover" /><corners android:topLeftRadius="@dimen/si_radius_lg" android:topRightRadius="@dimen/si_radius_lg" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" /></shape></item></layer-list></item>
    <item android:state_pressed="true"><layer-list><item android:top="0dp" android:bottom="-2dp"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:topLeftRadius="@dimen/si_radius_lg" android:topRightRadius="@dimen/si_radius_lg" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" /></shape></item><item android:gravity="bottom" android:left="16dp" android:height="1dp"><shape android:shape="rectangle"><solid android:color="@color/si_border" /></shape></item></layer-list></item>
    <item android:state_hovered="true"><layer-list><item android:top="0dp" android:bottom="-2dp"><shape android:shape="rectangle"><solid android:color="@color/si_raised" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:topLeftRadius="@dimen/si_radius_lg" android:topRightRadius="@dimen/si_radius_lg" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" /></shape></item><item android:gravity="bottom" android:left="16dp" android:height="1dp"><shape android:shape="rectangle"><solid android:color="@color/si_border" /></shape></item></layer-list></item>
    <item><layer-list><item android:top="0dp" android:bottom="-2dp"><shape android:shape="rectangle"><solid android:color="@color/si_surface" /><stroke android:width="1dp" android:color="@color/si_border" /><corners android:topLeftRadius="@dimen/si_radius_lg" android:topRightRadius="@dimen/si_radius_lg" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" /></shape></item><item android:gravity="bottom" android:left="16dp" android:height="1dp"><shape android:shape="rectangle"><solid android:color="@color/si_border" /></shape></item></layer-list></item>
</selector>

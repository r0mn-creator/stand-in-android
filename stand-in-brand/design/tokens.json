{
  "_about": "Stand-In design tokens. The single source for every client; run generate.py after changing anything here. Sizes are dp (Android) = logical px (desktop).",

  "themes": {
    "midnight-slate": {
      "ground": "#12161C",
      "surface": "#1A2029",
      "raised": "#222A35",
      "border": "#2C3542",
      "borderStrong": "#3A4554",
      "text": "#E6EAF0",
      "muted": "#98A2B3",
      "subtle": "#6B7686",
      "accent": "#2DD4BF",
      "accentHover": "#5EEAD4",
      "accentSoft": "#1F2DD4BF",
      "onAccent": "#04201C",
      "warning": "#F5A524",
      "warningSoft": "#2A2416",
      "danger": "#F87171",
      "dangerSoft": "#2A1A1C",
      "scrim": "#99000000"
    }
  },
  "defaultTheme": "midnight-slate",

  "status": {
    "awake": "accent",
    "inUse": "warning",
    "notPaired": "warning",
    "asleep": "muted",
    "offline": "subtle"
  },

  "font": {
    "family": "Inter",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },

  "type": {
    "display":  { "size": 26, "weight": "bold",     "lineHeight": 32 },
    "title":    { "size": 20, "weight": "semibold", "lineHeight": 26 },
    "headline": { "size": 17, "weight": "semibold", "lineHeight": 22 },
    "body":     { "size": 15, "weight": "regular",  "lineHeight": 21 },
    "bodyStrong": { "size": 15, "weight": "semibold", "lineHeight": 21 },
    "button":   { "size": 15, "weight": "semibold", "lineHeight": 20 },
    "label":    { "size": 13, "weight": "medium",   "lineHeight": 18 },
    "caption":  { "size": 12, "weight": "regular",  "lineHeight": 16 },
    "code":     { "size": 32, "weight": "bold",     "lineHeight": 40 }
  },

  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 40 },

  "radius": { "xs": 8, "sm": 12, "md": 16, "lg": 22, "xl": 28 },

  "size": {
    "contentWidth": 720,
    "gutter": 24,
    "headerHeight": 56,
    "iconButton": 44,
    "icon": 22,
    "iconSmall": 18,
    "button": 44,
    "buttonLarge": 48,
    "heroButtonWidth": 220,
    "input": 48,
    "row": 56,
    "rowWithSubtitle": 68,
    "tileWidth": 112,
    "tileHeight": 96,
    "logo": 28,
    "statusDot": 8,
    "focusRing": 2,
    "sidebarWidth": 220,
    "dialogWidth": 440
  },

  "motion": { "fast": 120, "normal": 180, "page": 220 }
}
